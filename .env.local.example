# HumanOS - Variables de Entorno (template)
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local.

# Supabase (proyecto bzeoszympkkicwlfdtcn)
NEXT_PUBLIC_SUPABASE_URL=https://bzeoszympkkicwlfdtcn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase dashboard>

# Resend (transactional email - usado en Group 4 NotificationEngine)
RESEND_API_KEY=<from resend dashboard>

# New Group 2
SUPABASE_SERVICE_ROLE_KEY=
RESEND_FROM_EMAIL=HumanOS <notificaciones@rein-eisenwerk.com>
RESEND_REPLY_TO=samantha.kosmas@iconsanet.com
NEXT_PUBLIC_APP_URL=https://humanos.rein-eisenwerk.com
CRON_SECRET=

# Onboarding (Batch 3 NEW.A)
# Token HMAC para validar wizard sessions en reportOnboardingErrorAction.
# Generar con: openssl rand -hex 32  (minimo 32 chars).
ONBOARDING_TOKEN_SECRET=

# Observabilidad - Sentry (Batch H 2026-05-29). Todo opcional: sin DSN el SDK es no-op.
# Paso de Jaime (una vez): crear proyecto en sentry.io -> copiar DSN aqui + en Vercel.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN solo si quieres separar el DSN de servidor del de cliente; por defecto usa el publico.
SENTRY_DSN=
# Para subir source maps + release tracking (setear en Vercel + CI, no en local):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# E2E local gate (revalidated audit P2). Only needed to run `npm run verify:e2e` locally.
# The authenticated Playwright project (admin-empleados) logs in as this seeded hr_admin user and
# saves e2e/.auth/hr_admin.json. The core `npm run verify` (== CI) does NOT require these; the
# public Playwright project (login/forgot/reset/onboarding) also runs without them.
E2E_HR_ADMIN_EMAIL=
E2E_HR_ADMIN_PASSWORD=
